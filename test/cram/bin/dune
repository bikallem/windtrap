; mkdata.exe writes the dumps and verdict files that the sessions merge.

(executable
 (name mkdata)
 (modules mkdata)
 (libraries windtrap_runtime))

(cram
 (applies_to :whole_subtree)
 (deps %{bin:windtrap} mkdata.exe))

; A library under both backends in every build, and two suites over it. A
; session copies them into a scratch build directory, where their runs
; write their dumps and verdict files; the recorded source is calc.ml.

(library
 (name bin_calc)
 (modules calc)
 (preprocess
  (pps ppx_windtrap.coverage ppx_windtrap.mutate)))

(executables
 (names pins_add pins_sub pins_both)
 (modules pins_add pins_sub pins_both)
 (libraries windtrap bin_calc))

; The inline runner of a library with two test files, for two_suites.t.

(executable
 (name pins_inline)
 (modules pins_inline inline_adds inline_subs)
 (libraries windtrap ppx_windtrap.runtime bin_calc)
 (preprocess
  (pps ppx_windtrap)))

; A second library for since.t, whose only mutants are drop mutants, and
; the suite over it.

(library
 (name bin_cases)
 (modules cases)
 (preprocess
  (pps ppx_windtrap.mutate)))

(executable
 (name pins_cases)
 (modules pins_cases)
 (libraries windtrap bin_cases))

(cram
 (package ppx_windtrap)
 (applies_to data)
 (deps pins_add.exe calc.ml))

; two_executables.t runs the mutation loop, which Windows refuses for want
; of fork.

(cram
 (package ppx_windtrap)
 (applies_to two_executables)
 (enabled_if
  (<> %{os_type} Win32))
 (deps pins_add.exe pins_sub.exe calc.ml))

; two_suites.t runs the mutation loop, which Windows refuses for want of fork.

(cram
 (package ppx_windtrap)
 (applies_to two_suites)
 (enabled_if
  (<> %{os_type} Win32))
 (deps pins_both.exe pins_inline.exe calc.ml))

; unreadable.t makes files and directories unreadable with chmod and plants
; a dangling symbolic link, which Windows does not do.

(cram
 (applies_to unreadable)
 (enabled_if
  (<> %{os_type} Win32)))

; full.t writes to /dev/full, which only Linux has.

(cram
 (applies_to full)
 (enabled_if
  (= %{system} linux)))

; since.t runs the mutation loop, which Windows refuses for want of fork,
; and git in a repository of its own. A host with no git on PATH, such as a
; minimal package sandbox, skips it.

(cram
 (package ppx_windtrap)
 (applies_to since)
 (enabled_if
  (and
   (<> %{os_type} Win32)
   %{bin-available:git}))
 (deps pins_add.exe calc.ml pins_cases.exe cases.ml))

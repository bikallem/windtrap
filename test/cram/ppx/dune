; pp.exe links every rewriter and -apply names the ones a run applies. Under
; -apply, ppxlib runs the instrumenting rewriters in the order they are
; linked, whatever order -apply names them in: pp.exe runs mutation before
; coverage, the order of the driver dune builds for a stanza naming both
; backends, and coverage_first.exe links them the other way round.

(library
 (name windtrap_test_ppx_generated)
 (modules generated)
 (kind ppx_rewriter)
 (libraries ppxlib))

(executable
 (name pp)
 (modules pp)
 (libraries
  ppxlib
  windtrap_test_ppx_generated
  windtrap_mutate_ppx
  windtrap_coverage_ppx
  ppx_windtrap))

(executable
 (name coverage_first)
 (modules coverage_first)
 (libraries ppxlib windtrap_coverage_ppx windtrap_mutate_ppx))

(executable
 (name elide)
 (modules elide)
 (libraries ppxlib)
 (preprocess
  (pps ppxlib.metaquot)))

(cram
 (package ppx_windtrap)
 (applies_to coverage mutate)
 (deps pp.exe coverage_first.exe elide.exe))

; coverage_functions.t pins the compiler's printer, whose spelling of a
; function's parameters, return constraint and coercion settled in OCaml
; 5.2; expect_typing.t pins the wording of a type error, settled in 5.4.

(cram
 (package ppx_windtrap)
 (applies_to coverage_functions)
 (enabled_if
  (>= %{ocaml_version} 5.2))
 (deps pp.exe elide.exe))

; mutate_functions.t pins the attributes of a function with cases after
; parameters, which the parser puts on its cases from OCaml 5.2.

(cram
 (package ppx_windtrap)
 (applies_to mutate_functions)
 (enabled_if
  (>= %{ocaml_version} 5.2))
 (deps pp.exe elide.exe))

; mutate_effects.t parses the effect cases of OCaml 5.3.

(cram
 (package ppx_windtrap)
 (applies_to mutate_effects)
 (enabled_if
  (>= %{ocaml_version} 5.3))
 (deps pp.exe elide.exe))

; mutate_labeled_tuples.t parses the labeled tuples of OCaml 5.4. ppxlib
; 0.37 stops on a labeled tuple, so the session also needs ppxlib 0.38.

(cram
 (package ppx_windtrap)
 (applies_to mutate_labeled_tuples)
 (enabled_if
  (and
   (>= %{ocaml_version} 5.4)
   (>= %{version:ppxlib} 0.38)))
 (deps pp.exe elide.exe))

; mutate_scale.t limits the processor time of the rewriter with ulimit,
; which the shell of Windows does not have.

(cram
 (package ppx_windtrap)
 (applies_to mutate_scale)
 (enabled_if
  (<> %{os_type} Win32))
 (deps pp.exe elide.exe))

(cram
 (package ppx_windtrap)
 (applies_to expect)
 (deps pp.exe))

; expect_typing.t types an expansion against the installed libraries, so
; it depends on both packages; SKIP_PACKAGE_SESSIONS: see test/cram/run/dune.

(cram
 (applies_to expect_typing)
 (package ppx_windtrap)
 (enabled_if
  (and
   (>= %{ocaml_version} 5.4)
   (<> %{env:SKIP_PACKAGE_SESSIONS=} true)))
 (deps
  pp.exe
  (package windtrap)
  (package ppx_windtrap)))
